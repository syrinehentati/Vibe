{
  "manifest_version": 3,
  "name": "Vibe",
  "version": "1.0.0",
  "description": "Generate emails that match your contact's exact tone.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://vibe-production-1126.up.railway.app/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Vibe"
  }
}